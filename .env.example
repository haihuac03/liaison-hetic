# Base Turso distante. En production Vercel, ne jamais utiliser une URL file:.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Store Blob privé relié au projet. Sur Vercel, BLOB_STORE_ID suffit avec OIDC.
BLOB_STORE_ID=
# Alternative locale ou hors Vercel.
BLOB_READ_WRITE_TOKEN=

# Origine canonique, sans slash final.
APP_ORIGIN=https://your-project.vercel.app

# true sur Vercel (HTTPS), false pour un développement local en HTTP.
COOKIE_SECURE=false
